---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { site } from "../config";

interface Props {
  title: string;
  description?: string;
  featuredImage?: string;
}

const {
  title,
  description = "",
  featuredImage = site.defaultFeaturedImage
} = Astro.props;
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "/index.html";
const fullTitle = `${title} – ${site.title}`;
const socialDescription = description || site.description;
const absoluteImage = new URL(featuredImage, Astro.site);
const absolutePage = new URL(isHome ? "/" : Astro.url.pathname, Astro.site);
---

<!doctype html>
<html class="no-js" lang="en">
  <head>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2">
    <link rel="manifest" href="/site.webmanifest">

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <title>{fullTitle}</title>
    <meta name="description" content={description}>

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={fullTitle}>
    <meta name="twitter:description" content={socialDescription}>
    <meta name="twitter:image:src" content={absoluteImage}>

    <meta property="og:title" content={fullTitle}>
    <meta property="og:description" content={socialDescription}>
    <meta property="og:image" content={absoluteImage}>
    <meta property="og:url" content={absolutePage}>
    <meta property="og:type" content="website">

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive-fixes.css">

    <script is:inline defer src="https://use.fontawesome.com/releases/v5.1.1/js/solid.js" integrity="sha384-GXi56ipjsBwAe6v5X4xSrVNXGOmpdJYZEEh/0/GqJ3JTHsfDsF8v0YQvZCJYAiGu" crossorigin="anonymous"></script>
    <script is:inline defer src="https://use.fontawesome.com/releases/v5.1.1/js/brands.js" integrity="sha384-0inRy4HkP0hJ038ZyfQ4vLl+F4POKbqnaUB6ewmU4dWP0ki8Q27A0VFiVRIpscvL" crossorigin="anonymous"></script>
    <script is:inline defer src="https://use.fontawesome.com/releases/v5.1.1/js/fontawesome.js" integrity="sha384-NY6PHjYLP2f+gL3uaVfqUZImmw71ArL9+Roi9o+I4+RBqArA2CfW1sJ1wkABFfPe" crossorigin="anonymous"></script>
  </head>

  <body class="loading" data-site-url="https://cedriccolas.com" data-page-url={Astro.url.pathname.replace("index.html", "")}>
    <Header />

    <div class="loader"><svg width="120" height="30" viewBox="0 0 120 30" xmlns="http://www.w3.org/2000/svg"><circle cx="15" cy="15" r="15"><animate attributeName="r" from="15" to="15" begin="0s" dur="0.8s" values="15;9;15" calcMode="linear" repeatCount="indefinite"></animate><animate attributeName="fill-opacity" from="1" to="1" begin="0s" dur="0.8s" values="1;.5;1" calcMode="linear" repeatCount="indefinite"></animate></circle><circle cx="60" cy="15" r="9" fill-opacity="0.3"><animate attributeName="r" from="9" to="9" begin="0s" dur="0.8s" values="9;15;9" calcMode="linear" repeatCount="indefinite"></animate><animate attributeName="fill-opacity" from="0.5" to="0.5" begin="0s" dur="0.8s" values=".5;1;.5" calcMode="linear" repeatCount="indefinite"></animate></circle><circle cx="105" cy="15" r="15"><animate attributeName="r" from="15" to="15" begin="0s" dur="0.8s" values="15;9;15" calcMode="linear" repeatCount="indefinite"></animate><animate attributeName="fill-opacity" from="1" to="1" begin="0s" dur="0.8s" values="1;.5;1" calcMode="linear" repeatCount="indefinite"></animate></circle></svg></div>
    <div class="page-loader"></div>

    <div class="page">
      <div class="page__content" data-page-title={fullTitle}>
        <slot />
      </div>
    </div>

    <Footer />

    <div id="lightbox" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.92); z-index:9999; align-items:center; justify-content:center;">
      <img id="lightbox-img" src="" alt="" style="max-width:92vw; max-height:92vh; border-radius:8px; box-shadow:0 0 40px rgba(0,0,0,.6); object-fit:contain;">
      <div id="lightbox-close" style="position:absolute; top:16px; right:24px; font-size:28px; color:#fff; cursor:pointer; opacity:.7; transition:opacity .2s;" onmouseenter="this.style.opacity=1" onmouseleave="this.style.opacity=.7">&#10005;</div>
      <div id="lightbox-prev" style="position:absolute; left:16px; top:50%; transform:translateY(-50%); font-size:40px; color:#fff; cursor:pointer; opacity:.7; transition:opacity .2s; padding:10px;" onmouseenter="this.style.opacity=1" onmouseleave="this.style.opacity=.7">&#9664;</div>
      <div id="lightbox-next" style="position:absolute; right:16px; top:50%; transform:translateY(-50%); font-size:40px; color:#fff; cursor:pointer; opacity:.7; transition:opacity .2s; padding:10px;" onmouseenter="this.style.opacity=1" onmouseleave="this.style.opacity=.7">&#9654;</div>
      <div id="lightbox-counter" style="position:absolute; bottom:16px; left:50%; transform:translateX(-50%); color:rgba(255,255,255,.6); font-size:14px;"></div>
    </div>

    <script is:inline src="https://ajax.googleapis.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>
    <script is:inline>
      // Kramdown wrapped standalone raw images in a paragraph. Astro leaves
      // them unwrapped, so restore that DOM shape for the existing theme code.
      document.querySelectorAll(".single .wrap > img").forEach((image) => {
        const paragraph = document.createElement("p");
        image.replaceWith(paragraph);
        paragraph.append(image);
      });
    </script>
    <script is:inline src="/js/plugins-min.js"></script>
    <script is:inline src="/js/index-min.js"></script>
  </body>
</html>
