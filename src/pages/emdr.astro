  .range-label { display: flex; justify-content: space-between; gap: 10px; font-size: 13px; }
  .parameter-heading { display: flex; align-items: center; gap: 10px; }
  .parameter-heading label { flex: 1; }
  .default-button { padding: 4px 7px; border-radius: 5px; font-size: 10px; color: #b7b3d5; }
  output { color: #ff85b5; font-size: 11px; }
  .helper { color: #9591bc; font-size: 11px; line-height: 1.6; margin: 6px 0 21px; }
  .test-buttons { display: flex; gap: 8px; margin: 15px 0; }
  .preview-sound { width: 100%; font-size: 12px; margin-bottom: 24px; }
  .test-buttons button { flex: 1; padding: 9px 5px; font-size: 12px; }
  details { border-top: 1px solid #ffffff12; padding: 15px 0; font-size: 12px; line-height: 1.7; color: #aaa6cb; }
  summary { cursor: pointer; color: #c8c4e4; font-size: 12px; }
  details p { margin: 13px 0; }
  details ol { padding-left: 17px; }
  details li { margin-bottom: 10px; }
  details a { font-size: 11px; }
  .panel-extras { margin-bottom: 22px; }
  .panel-extras button { width: 100%; font-size: 12px; }
  .panel-extras p { font-size: 11px; color: #8e8ab7; text-align: center; margin: 13px 0; }
  @media (max-width: 600px) { .ball { width: 56px; height: 56px; } .settings-panel { padding: 23px; } }
  @media (prefers-reduced-motion: reduce) { .drawer-rail, .settings-panel { transition: none; } }
</style>
