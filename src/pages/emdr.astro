  .duration-choice button[aria-pressed="true"] { color: #ff8cbb; border-color: #fe4791; background: #fe47911a; }
  .remaining { position: absolute; top: calc(100% + 62px); width: 100%; margin: 0; font-size: 12px; color: #aaa6cb; text-align: center; font-variant-numeric: tabular-nums; }
  .transport button { border-radius: 8px; min-width: 104px; padding: 12px 25px; font-size: 14px; letter-spacing: .02em; }
