  .icon-button { border: 0; padding: 0 6px; font-size: 25px; line-height: 1; background: none; color: #aaa8d0; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  fieldset { border: 0; border-top: 1px solid #ffffff12; padding: 21px 0 24px; margin: 0; min-width: 0; }
  legend { float: left; width: 100%; padding: 0; margin-bottom: 18px; font-size: 11px; text-transform: uppercase; letter-spacing: .12em; color: #a6a2d1; }
  fieldset > legend + * { clear: both; }
  .choice { display: flex; gap: 10px; align-items: center; padding: 10px 0; font-size: 14px; cursor: pointer; }
