  .transport .run:hover:not(:disabled) { background: #ff71a9; }
  .drawer-rail { position: fixed; z-index: 2; left: 0; top: 0; bottom: 0; width: min(360px, calc(100vw - 36px)); transform: translateX(-100%); transition: transform .22s ease; pointer-events: none; }
  .settings-toggle { position: absolute; left: 100%; top: 28px; width: 28px; height: 48px; padding: 4px; border-left: 0; border-radius: 0 9px 9px 0; background: #141346; color: #b5b3dc; pointer-events: auto; }
  .settings-panel { position: absolute; inset: 0; width: 100%; padding: 27px; overflow-y: auto; overscroll-behavior: contain; background: #10103d; border-right: 1px solid #ffffff16; visibility: hidden; transition: visibility .22s; scrollbar-width: thin; scrollbar-color: #44416c transparent; box-shadow: 15px 0 50px #00000018; }
  .drawer-rail.open { transform: translateX(0); pointer-events: auto; }
